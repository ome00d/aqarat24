        function approvePost(id) {
            const post = pendingProperties.find(p => p.id == id);
            if (post) {
                properties.unshift(post);
                pendingProperties = pendingProperties.filter(p => p.id != id);
                refreshAllGrids();
                alert("موڵک بە سەرکەوتوویی پەسەندکرا!");
            }
        }

        function rejectPost(id) {
            pendingProperties = pendingProperties.filter(p => p.id != id);
            refreshAllGrids();
            alert("پۆست هاتە ڕەتکرن.");
        }

        // SUBMIT AND SEND TO PENDING FOR APPROVAL (Routing back as standard flow)
        function submitForApproval() {
            if (!currentUser) {
                alert("تکایە خۆتۆماربکە یان ب مێهڤانی داخل ببە بۆ زیادکردنا مۆلکان!");
                openAuthModal();
                return;
            }

            const phone1 = document.getElementById('input-phone-1').value;
            const location = document.getElementById('input-location').value;
            const type = document.getElementById('input-type').value;

            if (!phone1 || !location || !type) {
                alert("تکایە خانەیێن ناچاری پڕ بکە (تەلەفۆنێ ١، ناڤونیشان، جۆرێ موڵکی)!");
                return;
            }

            const phone2 = document.getElementById('input-phone-2').value;
            const phone3 = document.getElementById('input-phone-3').value;
            const phonesArray = [phone1];
            if (phone2 && phone2.trim() !== '') phonesArray.push(phone2);
            if (phone3 && phone3.trim() !== '') phonesArray.push(phone3);

            const price = parseFloat(document.getElementById('input-price').value) || 0;
            const code = document.getElementById('input-code').value || "AQ-NEW";
            const payment = document.getElementById('input-payment').value;
            const city = document.getElementById('input-city').value || "-";
            const deed = document.getElementById('input-deed').value;
            const area = document.getElementById('input-area').value || "";
            const rooms = document.getElementById('input-rooms').value || "";
            const age = document.getElementById('input-age').value;
            const floors = document.getElementById('input-floors').value || "";
            const direction = document.getElementById('input-direction').value || "-";
            const status = document.getElementById('input-status').value;
            const landNumber = document.getElementById('input-land-number').value || "-";

            const features = [];
            if (document.getElementById('check-garage').checked) features.push("گەراجێ تڕۆمبێلێ");
            if (document.getElementById('check-pool').checked) features.push("مەسبەح (حەوز)");
            if (document.getElementById('check-furnished').checked) features.push("کەلوپەل تێدانە");
            if (document.getElementById('check-cameras').checked) features.push("کامێرێن چاڤدێریێ");
            if (document.getElementById('check-elevator').checked) features.push("لێفت");

            const lat = pickedCoords.lat;
            const lng = pickedCoords.lng;

            let propertyImgList = [...selectedBase64Images];
            if (propertyImgList.length === 0) {
                propertyImgList = [
                    type === 'مەزرەعە' 
                    ? "https://images.unsplash.com/photo-1592595896551-12b371d546d5?auto=format&fit=crop&w=600&h=400&q=80"
                    : "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=600&h=400&q=80"
                ];
            }

            const isFeaturedFlag = (type === 'ڤێلا'); 

            // Pushed as pending for admin approval
            const newPendingPost = {
                id: Date.now(),
                title: `${type} نوو ل دهۆکێ`,
                code: code,
                type: type,
                location: location,
                city: city,
                price: price,
                area: area,
                rooms: rooms,
                phones: phonesArray,
                lat: lat,
                lng: lng,
                status: status,
                deed: deed,
                payment: payment,
                age: age,
                floors: floors,
                direction: direction,
                landNumber: landNumber,
                features: features,
                images: propertyImgList,
                isFeatured: isFeaturedFlag,
                isPrivate: false,
                isArchived: false,
                ownerId: currentUser.id
            };

            pendingProperties.push(newPendingPost);
            refreshAllGrids();
            
            alert("مۆڵک ب سەرکەفتی هاتە ناردن! ل هیڤیا پەسەندکرنا ئەدمینی بمینە.");
            resetAddForm();
            switchTab('home');
        }

