 <!DOCTYPE html>
<html lang="ku" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aqarat 24</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
    <!-- Leaflet Map CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Kurdish Font -->
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Vazirmatn', sans-serif;
            transition: background-color 0.3s, color 0.3s;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col overflow-x-hidden transition-all duration-300">

    <!-- INSTAGRAM STYLE PULL REFRESH INDICATOR -->
    <div id="pull-refresh-indicator" class="w-full flex items-center justify-center h-0 overflow-hidden transition-all duration-200 bg-slate-100 dark:bg-slate-900/60 shrink-0">
        <div class="flex items-center gap-2 py-2">
            <svg class="animate-spin h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="text-xs text-slate-500 font-bold" data-i18n="lbl_refreshing">نووکرن...</span>
        </div>
    </div>

    <!-- TOP NAV BAR -->
    <header class="sticky top-0 z-40 bg-white/85 dark:bg-slate-950/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 shadow-sm transition">
        <div class="max-w-7xl mx-auto px-4 h-16 flex justify-between items-center">
            <span class="text-xl font-bold bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent select-none">
                Aqarat 24
            </span>

            <div class="flex items-center gap-3">
                <button onclick="toggleDarkMode()" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                </button>

                <!-- Profile Auth Badge -->
                <div id="user-badge" class="flex items-center gap-2">
                    <button onclick="openAuthModal()" data-i18n="auth_btn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs transition shadow">
                        چوونەژوور / پڕۆفایل
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- CONTENT VIEW AREA -->
    <main class="flex-1 w-full pb-20">

        <!-- SCREEN 1: HOME -->
        <div id="screen-home" class="screen-tab p-4 max-w-7xl mx-auto space-y-4">
            
            <!-- THIN & COMPACT FILTER TOGGLER -->
            <div class="space-y-2">
                <div class="bg-slate-50 dark:bg-slate-900 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex justify-between items-center transition-all duration-300">
                    <span class="text-xs font-bold text-slate-700 dark:text-slate-300" data-i18n="lbl_filter_title">گالەرییا موڵکان فلتەر بکە</span>
                    <button onclick="toggleFilterCollapse()" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs flex items-center gap-1 transition">
                        <span>🔍</span> <span data-i18n="btn_filter_toggle">فلتەر</span>
                    </button>
                </div>

                <!-- COLLAPSED FILTERS container -->
                <div id="filter-collapse-box" class="hidden bg-slate-50 dark:bg-slate-900 p-4 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-md space-y-3 transition-all duration-300">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                        <div>
                            <label class="text-[9px] text-slate-500 dark:text-slate-400 block mb-1" data-i18n="lbl_type">جۆرێ مۆڵکی</label>
                            <select id="filter-type" onchange="applyFilters()" class="w-full p-2 text-[11px] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl">
                                <option value="all" data-i18n="opt_all">هەمی</option>
                                <option value="ڤێلا" data-i18n="type_villa">ڤێلا</option>
                                <option value="shqe" data-i18n="type_apt">شوقە</option>
                                <option value="خانی" data-i18n="type_house">خانی</option>
                                <option value="ئەرد" data-i18n="type_land">ئەرد</option>
                                <option value="مەزرەعە" data-i18n="type_farm">مەزرەعە</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[9px] text-slate-500 dark:text-slate-400 block mb-1" data-i18n="lbl_status">بۆچ مۆلکە؟</label>
                            <select id="filter-status" onchange="applyFilters()" class="w-full p-2 text-[11px] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl">
                                <option value="all" data-i18n="opt_all">هەمی</option>
                                <option value="sale" data-i18n="opt_status_sale">بۆ فرۆتن</option>
                                <option value="rent" data-i18n="opt_status_rent">ب کرێ</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[9px] text-slate-500 dark:text-slate-400 block mb-1" data-i18n="lbl_min_price">کەمترین بها ($)</label>
                            <input id="filter-min-price" type="number" oninput="applyFilters()" placeholder="0" class="w-full p-2 text-[11px] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                        </div>
                        <div>
                            <label class="text-[9px] text-slate-500 dark:text-slate-400 block mb-1" data-i18n="lbl_max_price">زۆرترین بها ($)</label>
                            <input id="filter-max-price" type="number" oninput="applyFilters()" placeholder="500000" class="w-full p-2 text-[11px] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <div class="flex-1">
                            <input id="filter-city" type="text" oninput="applyFilters()" placeholder="گەڕەکەک بنڤیسە... (مەسەلا: نەورۆز)" class="w-full p-2 text-xs border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                        </div>
                        <button onclick="clearFilters()" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-bold transition">
                            پاككردنەوە
                        </button>
                    </div>
                </div>
            </div>

            <!-- Featured Showcase Slider -->
            <div class="space-y-3">
                <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider" id="txt-slider-title" data-i18n="slider_title">مەزرەعە و ڤێلا</h2>
                <div id="featured-slider" class="flex gap-3 overflow-x-auto pb-2 no-scrollbar snap-x w-full">
                    <!-- Dynamic Featured slider items -->
                </div>
            </div>

            <!-- New Properties List -->
            <div class="space-y-3">
                <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider" id="txt-new-prop-title" data-i18n="new_prop_title">مۆلکێن نوو</h2>
                <div id="properties-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                    <!-- Square Cards will render here -->
                </div>
                <!-- Load More container -->
                <div id="load-more-container" class="w-full flex justify-center pt-4 hidden">
                    <button onclick="loadMoreProperties()" class="px-6 py-2.5 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold rounded-2xl text-xs transition" data-i18n="btn_load_more">
                        مۆری / زێدەتر نیشان بدە
                    </button>
                </div>
            </div>
        </div>

        <!-- SCREEN 2: APARTMENTS (Reels layout 9:16) -->
        <div id="screen-apartment" class="screen-tab p-4 max-w-7xl mx-auto space-y-4 hidden">
            <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider" id="txt-apt-title" data-i18n="apt_title">شوقە (شقه)</h2>
            <div id="apartments-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                <!-- Reels layout with 9:16 aspect ratio -->
            </div>
        </div>

        <!-- SCREEN 3: MAP -->
        <div id="screen-map" class="screen-tab h-[calc(100vh-8.5rem)] w-full flex flex-col hidden relative">
            <div id="map-container" class="flex-1 w-full"></div>
            
            <!-- MODERN COMPASS TARGET FLOATING ACTION BUTTON -->
            <button onclick="locateOnMap(map, null)" class="absolute bottom-24 right-4 z-[1000] w-12 h-12 bg-blue-600 hover:bg-blue-700 text-white rounded-full flex items-center justify-center shadow-2xl transition-all duration-300 hover:scale-110" title="Find My Location">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"></circle>
                    <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2m10-10h-2M4 12H2"></path>
                </svg>
            </button>

            <div class="bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 px-4 py-3 flex flex-wrap gap-4 justify-center items-center text-[10px] select-none shrink-0 font-bold">
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#EF4444]"></span> <span data-i18n="type_villa">ڤێلا</span></span>
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#3B82F6]"></span> <span data-i18n="type_apt">شوقە</span></span>
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#10B981]"></span> <span data-i18n="type_house">خانی</span></span>
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#F59E0B]"></span> <span data-i18n="type_land">ئەرد</span></span>
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#8B5CF6]"></span> <span data-i18n="type_farm">مەزرەعە</span></span>
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#374151]"></span> <span data-i18n="status_sold">هاتە فرۆتن</span></span>
            </div>

            <div class="absolute top-4 left-4 z-[1000] bg-white/95 dark:bg-slate-950/95 border border-slate-200 dark:border-slate-800 p-1 rounded-xl shadow-lg flex gap-1">
                <button onclick="changeMapStyle('standard', this)" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-blue-900 text-blue-300" data-i18n="map_std">ڕوون / سافی</button>
                <button onclick="changeMapStyle('satellite', this)" class="px-2.5 py-1 text-[11px] font-bold rounded-lg text-slate-500 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800" data-i18n="map_sat">سەتەلایت</button>
                <button onclick="changeMapStyle('dark', this)" class="px-2.5 py-1 text-[11px] font-bold rounded-lg text-slate-500 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800" data-i18n="map_drk">تاری</button>
            </div>
        </div>

        <!-- SCREEN 4: ADD PROPERTY -->
        <div id="screen-add" class="screen-tab p-4 max-w-3xl mx-auto space-y-4 hidden">
            <h2 class="text-sm font-bold text-slate-400 uppercase tracking-wider" id="txt-add-title" data-i18n="add_title">زێدەکرنا مۆلکی</h2>
            
            <div class="bg-slate-50 dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
                
                <div class="bg-amber-950/40 border border-amber-900/60 p-3 rounded-xl text-[10px] text-amber-300 font-bold leading-relaxed">
                    ⚠️ ئاگاداری: مۆلکێ تە ب سەرکەفتی دهێتە ناردن لێ ڕاستەوخۆ ناچیتە بازارێ، بەڵکو دێ بیتە چاوەڕێ هەتا پەسەندکرنا ئەدمینی.
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1"><span data-i18n="lbl_price">بها ($)</span> <span class="text-slate-400">(ئارەزوومەندانە)</span></label>
                        <input id="input-price" type="number" placeholder="50000" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1"><span data-i18n="lbl_code">کۆدێ مۆلکی</span> <span class="text-slate-400">(ئارەزوومەندانە)</span></label>
                        <input id="input-code" type="text" placeholder="AQ-109" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1" data-i18n="lbl_payment">شێوازێ پارەدانێ</label>
                        <select id="input-payment" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                            <option value="کاش" data-i18n="opt_cash">کاش (نەختینە)</option>
                            <option value="قست" data-i18n="opt_install">ب قست</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1"><span data-i18n="lbl_location">ناڤونیشان (جهـ)</span> <span class="text-red-500 font-bold">* (ناچاری)</span></label>
                        <input id="input-location" type="text" placeholder="دهۆك، نەورۆز" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1"><span data-i18n="lbl_city">گەڕەک / باژێڕ</span> <span class="text-slate-400">(ئارەزوومەندانە)</span></label>
                        <input id="input-city" type="text" placeholder="باشوور" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1" data-i18n="lbl_deed">جۆرێ سندی (تاپۆ)</label>
                        <select id="input-deed" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                            <option value="تاپۆ مۆلک" data-i18n="opt_deed_own">تاپۆ مۆلک</option>
                            <option value="سند کارت" data-i18n="opt_deed_card">کارت</option>
                            <option value="زراعی" data-i18n="opt_deed_agr">زراعی</option>
                            <option value="سالنامە" data-i18n="opt_deed_year">سالنامە</option>
                        </select>
                    </div>
                </div>

                <!-- 3 PHONE INPUT FIELDS -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 border-t border-b border-slate-200 dark:border-slate-800 py-3 my-2">
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1">
                            <span data-i18n="lbl_phone">ژمارا تەلەفۆنێ ١</span> 
                            <span class="text-red-500 font-bold">* (ناچاری)</span>
                        </label>
                        <input id="input-phone-1" type="text" placeholder="0750XXXXXXX" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-left">
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1">
                            <span>ژمارا تەلەفۆنێ ٢</span> 
                            <span class="text-slate-400">(ئارەزوومەندانە)</span>
                        </label>
                        <input id="input-phone-2" type="text" placeholder="0750XXXXXXX" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-left">
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1">
                            <span>ژمارا تەلەفۆنێ ٣</span> 
                            <span class="text-slate-400">(ئارەزوومەندانە)</span>
                        </label>
                        <input id="input-phone-3" type="text" placeholder="0750XXXXXXX" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-left">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1"><span data-i18n="lbl_type">جۆرێ مۆلکی</span> <span class="text-red-500 font-bold">* (ناچاری)</span></label>
                        <select id="input-type" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                            <option value="ڤێلا" data-i18n="type_villa">ڤێلا</option>
                            <option value="shqe" data-i18n="type_apt">شوقە (شقه)</option>
                            <option value="خانی" data-i18n="type_house">خانی</option>
                            <option value="ئەرد" data-i18n="type_land">ئەرد (زەڤی)</option>
                            <option value="مەزرەعە" data-i18n="type_farm">مەزرەعە</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1"><span data-i18n="lbl_floors">ژمارا قاتان</span> <span class="text-slate-400">(ئارەزوومەندانە)</span></label>
                        <input id="input-floors" type="number" placeholder="2" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1"><span data-i18n="lbl_direction">ئاراستە</span> <span class="text-slate-400">(ئارەزوومەندانە)</span></label>
                        <input id="input-direction" type="text" placeholder="باشوور" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1"><span data-i18n="lbl_land_number">ژمارا ئەردی (زەڤی)</span> <span class="text-slate-400">(ئارەزوومەندانە)</span></label>
                        <input id="input-land-number" type="text" placeholder="مەسەلا 120/4 یان 5" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 dark:text-slate-400 block mb-1" data-i18n="lbl_status">بۆچ مۆلکە؟</label>
                        <select id="input-status" class="w-full p-2.5 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-xl text-right">
                            <option value="sale" data-i18n="opt_status_sale">بۆ فرۆتن</option>
                            <option value="rent" data-i18n="opt_status_rent">ب کرێ</option>
                            <option value="sold" data-i18n="opt_status_sold">هاتە فرۆتن</option>
                        </select>
                    </div>
                </div>

                <!-- Multiple images selection -->
                <div class="border-t border-slate-200 dark:border-slate-800 pt-3">
                    <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block mb-1" data-i18n="lbl_images">وێنەیێن موڵکی دەستنیشان بکە (هەتا ٧ وێنە):</label>
