        // Initialize Map
        function initMap() {
            if (!map) {
                map = L.map('map-container', { zoomControl: false }).setView([36.868, 42.997], 13);
                activeTileLayer = L.tileLayer(mapStyles.standard).addTo(map);
            }
            map.invalidateSize();
            renderMapMarkers();
        }

        // Initialize Location Map Picker inside Add screen
        function initPickerMap() {
            if (!pickerMap) {
                pickerMap = L.map('picker-map-container', { zoomControl: false }).setView([36.868, 42.997], 12);
                L.tileLayer(mapStyles.standard).addTo(pickerMap);

                pickerMarker = L.marker([36.868, 42.997], { draggable: true }).addTo(pickerMap);
                pickerMarker.on('dragend', function () {
                    pickedCoords = pickerMarker.getLatLng();
                });

                pickerMap.on('click', function (e) {
                    pickedCoords = e.latlng;
                    pickerMarker.setLatLng(pickedCoords);
                });
            }
            pickerMap.invalidateSize();
        }

        // Locate Me action (GPS tracker)
        function locateOnMap(mapInstance, markerInstance) {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (position) {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    mapInstance.setView([lat, lng], 15);
                    
                    if (markerInstance) {
                        markerInstance.setLatLng([lat, lng]);
                        pickedCoords = { lat: lat, lng: lng };
                    }
                }, function () {
                    alert("نەخێر! ڕێگە نەدرا بە دۆزینەوەی شوێن یان هێڵی تەلەفۆنت کێشەی هەیە.");
                });
            } else {
                alert("وێبگەڕەکەت پشتگیری دۆزینەوەی شوێن ناکات.");
            }
        }

